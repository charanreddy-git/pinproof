{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix client --include=dev && npm ci --prefix server --include=dev",
  "buildCommand": "npm run check",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.ts": { "maxDuration": 30, "includeFiles": "server/{src,prisma,node_modules}/**" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
