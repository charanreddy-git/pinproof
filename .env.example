# ============================================
# PinProof — Environment Variables
# ============================================
# Copy this file to server/.env and fill in
# your own values. Never commit real secrets.

# --- Server (.env in /server) ---

# PostgreSQL connection string.
# Neon example (use the pooled connection string for the app):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pinproof?sslmode=disable"

# JWT signing secret — at least 32 random characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"

# --- Mobile OTP auth ---
# Auth mode: otp (production default) or demo (development only).
# demo adds one-click requester/inspector sign-in and reset fixtures.
# AUTH_MODE=demo is always rejected when NODE_ENV=production.
AUTH_MODE="otp"

# console prints the code to the server log. Use fast2sms, twilio, or webhook
# in production.
SMS_PROVIDER="console"
# Optional. Defaults to JWT_SECRET. Rotating it invalidates pending OTPs.
# OTP_SECRET=""
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5

# Fast2SMS (SMS_PROVIDER=fast2sms).
# Create an API key in the Fast2SMS Dev API section.
# Docs: https://docs.fast2sms.com/reference/quick-sms-post
# FAST2SMS_API_KEY=""
# Route: q = Quick SMS, dlt = DLT Message ID, dlt_manual = full DLT template.
# FAST2SMS_ROUTE="q"
# Required for the dlt and dlt_manual routes.
# FAST2SMS_SENDER_ID=""
# Required for dlt: numeric DLT Message ID.
# FAST2SMS_MESSAGE_ID=""
# Optional for dlt: values for {#var#}; {code} becomes the OTP.
# FAST2SMS_VARIABLES_VALUES="{code}"
# For dlt_manual: full DLT-approved message. {code} becomes the OTP.
# FAST2SMS_MESSAGE_TEMPLATE="Your PinProof verification code is {code}. It expires in 5 minutes. Never share this code with anyone."
# Optional for dlt_manual.
# FAST2SMS_TEMPLATE_ID=""
# FAST2SMS_ENTITY_ID=""

# Twilio Programmable SMS (SMS_PROVIDER=twilio) — optional alternative.
# Indian SMS needs DLT-registered sender/template details in the Twilio console.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER="+1..."
# TWILIO_MESSAGING_SERVICE_SID=""

# Generic provider adapter (SMS_PROVIDER=webhook).
# Receives POST JSON: { "phone": "+91...", "code": "123456", "message": "..." }
# Point this at MSG91, Gupshup, Interakt, or your own WhatsApp/SMS service.
# SMS_WEBHOOK_URL=""
# SMS_WEBHOOK_TOKEN=""

# Server
PORT=3001
NODE_ENV=development

# Allowed client origin (CORS + Socket.IO)
CLIENT_URL="http://localhost:5173"

# --- Client (.env in /client) ---
# Optional in local development; Vite proxies /api and /socket.io to :3001.
# Set these only when the API is hosted separately.

# VITE_API_URL="http://localhost:3001/api"
# VITE_WS_URL="http://localhost:3001"
